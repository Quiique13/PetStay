{
  "name": "petstay",
  "version": "1.0.0",
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "description": "PetStay — gestão de hotéis para animais",
  "author": "Quiique13",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "build:portable": "npm run build:desktop && electron-builder --win portable --x64 --publish never",
    "test:portable": "node scripts/smoke-portable.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
