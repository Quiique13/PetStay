{
  "name": "petstay",
  "version": "1.6.0",
  "type": "module",
  "description": "PetStay — gestão de hotéis para animais",
  "author": "Quiique13",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "dev:mobile": "vite --mode mobile --host 127.0.0.1",
    "build:mobile": "npm run typecheck && vite build --mode mobile",
    "preview:mobile": "vite preview --mode mobile --host 127.0.0.1 --port 4174",
    "test:mobile": "npm run build:mobile && npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "start": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "firebase": "^13.2.0",
    "jose": "^6.2.16",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
